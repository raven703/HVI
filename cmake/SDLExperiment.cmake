# Pinned official SDL2 source. No changes to SDL's backend or the test object's input code.
include(FetchContent)
if(POLICY CMP0135)
 cmake_policy(SET CMP0135 NEW)
endif()
set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_STATIC OFF CACHE BOOL "" FORCE)
set(SDL_TEST ON CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL2_DISABLE_INSTALL ON CACHE BOOL "" FORCE)
FetchContent_Declare(sdl2 URL https://www.libsdl.org/release/SDL2-2.30.11.zip
 URL_HASH SHA256=a0b3e7ac5f708042683ff0f22e069bdf75563540c615f9854ecc9bc8913e2488)
FetchContent_MakeAvailable(sdl2)
add_executable(sdl_official_intersections "${sdl2_SOURCE_DIR}/test/testintersections.c")
target_link_libraries(sdl_official_intersections PRIVATE SDL2::SDL2main SDL2::SDL2test SDL2::SDL2)
set_target_properties(SDL2 PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
add_executable(sdl_input_test WIN32 experiments/sdl_input_test.cpp)
target_link_libraries(sdl_input_test PRIVATE SDL2::SDL2main SDL2::SDL2)
# Deliberately no hvi interface target, include directory, runtime import or pipe.
add_library(hvi_compat SHARED src/compat.cpp src/compat_trace.cpp)
target_include_directories(hvi_compat PRIVATE "${sdl2_SOURCE_DIR}/src/dynapi")
target_link_libraries(hvi_compat PRIVATE hvi hvi_runtime SDL2::SDL2 user32)
set_target_properties(hvi_compat PROPERTIES PREFIX "")
add_executable(hvi_sdl_demo WIN32 src/sdl_demo.cpp)
target_link_libraries(hvi_sdl_demo PRIVATE hvi user32)
add_dependencies(hvi_sdl_demo hvi_compat sdl_input_test hvi_gui_controller)
add_executable(event_reliability_tests src/event_reliability_tests.cpp)
target_link_libraries(event_reliability_tests PRIVATE hvi SDL2::SDL2)
add_dependencies(event_reliability_tests hvi_compat)
add_test(NAME event_delivery_reliability COMMAND event_reliability_tests)
set_tests_properties(event_delivery_reliability PROPERTIES LABELS "sdl_compatibility" TIMEOUT 120 RUN_SERIAL TRUE ENVIRONMENT "SDL_DYNAMIC_API=hvi_compat.dll;HVI_COMPAT_SESSION=93")
if(Python3_Interpreter_FOUND)
 add_test(NAME sdl_demo_launch COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/tests/sdl_demo_launch.py)
 set_tests_properties(sdl_demo_launch PROPERTIES LABELS "gui_integration;sdl_compatibility" RUN_SERIAL TRUE TIMEOUT 20)
 add_test(NAME second_sdl_app COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/tests/second_sdl_app.py)
 set_tests_properties(second_sdl_app PROPERTIES LABELS "sdl_compatibility" RUN_SERIAL TRUE TIMEOUT 45)
 add_test(NAME sdl_compatibility COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/tests/sdl_compatibility.py)
 set_tests_properties(sdl_compatibility PROPERTIES LABELS "gui_integration;sdl_compatibility" RUN_SERIAL TRUE TIMEOUT 60)
endif()